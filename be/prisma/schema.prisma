generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Facility {
  id       String @id
  name     String
  location String
  capacity String
  status   String
}

model Monitoring {
  id        String @id
  type      String
  parameter String
  value     String
  activity  String
}

model Report {
  id          String   @id
  category    String
  date        DateTime @db.Date
  status      String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CommunityNote {
  id     Int    @id
  userId Int
  title  String
  body   String
}
